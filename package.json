{
  "name": "@nomed/yukh-projects",
  "version": "1.7.0",
  "description": "Declarative, secure, and consumer-neutral reconciliation for GitHub Projects",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:mcp-effect-b-conformance": "node scripts/run-mcp-effect-b-conformance.mjs",
    "demo:e2e": "npm run build && node scripts/run-e2e-sandbox-demo.mjs",
    "build": "node scripts/clean-typescript-output.mjs && tsc -p tsconfig.json",
    "build:bundles": "node scripts/build-bundles.mjs",
    "verify:bundles": "npm run build:bundles && node scripts/verify-bundles.mjs",
    "verify:apply-candidate": "npm run verify:bundles",
    "audit": "npm audit --audit-level=moderate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nomed/yukh-projects"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nomed/yukh-projects/issues"
  },
  "homepage": "https://github.com/nomed/yukh-projects#readme",
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "esbuild": "0.28.1",
    "graphql": "17.0.2",
    "typescript": "5.9.3"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
